        searchHttp["POST /indexes/.../docs/search<br/>httpx · 只是傳輸層"]
        emb --> embHttp
        search --> searchHttp
    end

    assemble["rag.assemble_context · INTERNAL<br/>沒有上游呼叫"]

    subgraph generation["rag.generation · INTERNAL"]
        chat["chat {deployment}<br/>gen_ai.usage.* · azgenai.outcome"]
        chatHttp["POST /openai/v1/responses<br/>httpx · 回到 header 就結束，不是生成時間"]
        chat --> chatHttp
    end

    server --> retrieval
    server --> assemble
    server --> generation

    noAnswer["零 hits：整個 generation stage 不存在<br/>（Day 14 結構性 no-answer）"]
