flowchart TB
    server["POST /api/v1/rag<br/>SERVER · 掛 correlation_id"]

    subgraph retrieval["rag.retrieval · INTERNAL"]
        emb["embeddings {deployment}<br/>gen_ai.request.model"]
        search["azure.search.query<br/>azgenai.search.hit_count"]
