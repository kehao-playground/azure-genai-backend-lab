flowchart TB
    answer["pass B 的答案（文字）<br/>模型輸出，不可位元重現"]
    hashes["answer_sha256 · sources_sha256<br/>產出當下就算好"]
    answer --> hashes

    sidecar["evidence sidecar（--evidence-out）<br/>ids · counts · outcome · hash<br/>reference-only：型別裡沒有文字欄位"]
    comp["answers companion（--answers-out）<br/>問題 / 答案 / 來源全文 ＋ 同一組 hash<br/>寫入順序在 sidecar 之前（答案已 billed）"]

    hashes --> sidecar
    answer --> comp
    hashes --> comp

    recheck["判定前對帳：從 companion 的文字重算兩個 hash<br/>與 sidecar 比對——8 案全 MATCH 才開始讀"]
    comp --> recheck
    sidecar --> recheck

    human["人工判定（權威）<br/>綁 run_id ＋ answer_sha256，記在 run evidence<br/>不寫回 dataset"]
    recheck --> human
